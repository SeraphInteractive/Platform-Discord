{
  "name": "mcs-bot-worker",
  "version": "1.0.0",
  "description": "Read-only Discord bot and SSE event worker for MCM² ranked voting rounds, leaderboards, telemetry, and automated announcements",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/bot/deploy-commands.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "voting",
    "leaderboard",
    "telemetry",
    "sse",
    "mcm2"
  ],
  "author": "MCM² Team",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
