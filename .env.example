# ==========================================
# DISCORD BOT CREDENTIALS
# ==========================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
# Optional: Set DISCORD_GUILD_ID during development for instant slash command registration
DISCORD_GUILD_ID=

# ==========================================
# VOTING API & WEB APP
# ==========================================
# Base URL for the voting API
API_BASE_URL=http://localhost:3333/api/v1
# Public Web App URL for web interface links
WEB_APP_URL=http://localhost:5173

# API Bearer Token (required for accessing protected endpoints & telemetry SSE)
API_BEARER_TOKEN=your_api_bearer_token_here

# ==========================================
# AUTOMATED WORKER & ANNOUNCEMENT CHANNELS
# (Can also be set dynamically via /set-announcement-channel)
# ==========================================
ANNOUNCEMENT_CHANNEL_ID=
TELEMETRY_ALERT_CHANNEL_ID=

# Background worker polling frequency (milliseconds)
SSE_POLL_INTERVAL_MS=15000
